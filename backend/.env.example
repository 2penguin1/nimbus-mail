# Nimbus backend settings — copy to .env and edit.
#
#     cp backend/.env.example backend/.env
#
# .env is git-ignored. This file is committed, so it must never hold a real secret.
# Every value below is either a local Docker Compose address or an obvious placeholder.

# Ports 5433 and 6380, not the usual 5432 and 6379: this machine already runs a native
# PostgreSQL and Redis on the standard ports, so infra/docker-compose.yml maps ours one
# above. Inside the Docker network the containers still use the standard ports.
#
# No driver in the URL. api/config.py derives +asyncpg for the app and +psycopg for
# Alembic, so the two can never drift apart.
DATABASE_URL=postgresql://nimbus:nimbus@localhost:5433/nimbus
REDIS_URL=redis://localhost:6380/0

# Must be at least 32 characters — the API refuses to start otherwise. Generate a real
# one per environment and never reuse this placeholder:
#
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace-me-with-a-generated-secret-at-least-32-chars
JWT_TTL_HOURS=24

API_BASE_URL=http://127.0.0.1:8000

# ---- Object storage (MinIO locally, S3 in production) ----
# The receiver writes whole messages to the raw bucket; the worker writes deduplicated
# chunks to the chunk bucket. infra/docker-compose.yml creates both on startup.
#
# THIS ONE VARIABLE DECIDES MINIO VS REAL AWS, in both languages:
#
#   S3_ENDPOINT=http://localhost:9000   MinIO — path-style addressing (host/bucket/key)
#   S3_ENDPOINT=                        real AWS — the SDK resolves the regional
#                                       endpoint and uses bucket.host/key
#
# Leave it EMPTY on AWS, do not point it at s3.<region>.amazonaws.com. S3 buckets made
# after 30 September 2020 reject the path form, so a non-empty value there fails every
# upload — the receiver answers 451 and senders retry for days. See
# smtp-receiver/s3options_test.go, which exists to stop that coming back.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=nimbus
S3_SECRET_KEY=nimbus-dev-secret

# ---- Kafka / Redpanda ----
# Must match the Go receiver's KAFKA_SEEDS, or the worker listens to a different broker
# than the one mail is published to.
KAFKA_SEEDS=localhost:19092
